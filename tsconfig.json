{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    /* Base Options: */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    /* If NOT transpiling with TypeScript (using external bundler): */
    "module": "preserve",
    "noEmit": true,
    /* If your code doesn't run in the DOM (Node.js/Extensions): */
    "lib": ["es2022"]
  },
  "exclude": ["opensrc", "node_modules", "dist", "**/dist"]
}
